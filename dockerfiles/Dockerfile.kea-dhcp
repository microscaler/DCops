# Dockerfile for ISC Kea DHCP Server
# Used in bollard-based integration tests for DHCP functionality
# ISC Kea is the production DHCP server for integration with RouterOS switches/routers

FROM iscorg/kea:latest

# Install curl for health checks and API testing
RUN apt-get update && \
    apt-get install -y curl jq && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Expose ports:
# - 67/udp: DHCP server port
# - 8000/tcp: Kea Control Agent REST API
EXPOSE 67/udp 8000/tcp

# Default Kea configuration directory
WORKDIR /etc/kea

# Kea will be configured via Control Agent REST API (port 8000)
# No static config file needed - configuration is pushed via API
CMD ["kea-dhcp4", "-c", "/etc/kea/kea-dhcp4.conf"]



