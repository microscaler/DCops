# Multi-stage build for DCops Dashboard
FROM node:25-alpine AS builder

WORKDIR /app

COPY ui-dashboard/package.json ui-dashboard/yarn.lock* ./
RUN yarn install --frozen-lockfile

COPY ui-dashboard/ .
RUN yarn build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY dockerfiles/nginx.dcops-dashboard.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
