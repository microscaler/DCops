# Multi-stage build for DCops Docs
FROM node:25-alpine AS builder

WORKDIR /app

COPY ui-docs/package.json ui-docs/yarn.lock* ./
RUN yarn install --frozen-lockfile

COPY ui-docs/ .
RUN yarn build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY dockerfiles/nginx.dcops-docs.conf /etc/nginx/conf.d/default.conf

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
